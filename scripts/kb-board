#!/bin/bash
set -euo pipefail

die() {
  printf '%s\n' "$1" >&2
  exit 64
}


reject_selector_args() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --project|--project=*|--workspace|--workspace=*|--db|--db=*)
        die "kb-board injects exactly one --project selector; remove '$arg' and retry."
        ;;
      --registry|--registry=*|--all-boards|--all-boards=*)
        die "kb-board does not route registry or cross-board scope flag '$arg'."
        ;;
    esac
  done
}

reject_registry_commands() {
  case $1 in
    --project|--project=*|--workspace|--workspace=*|--db|--db=*|--registry|--registry=*|--all-boards|--all-boards=*)
      die "kb-board does not route registry or cross-board scope flag '$1'."
      ;;
    version|v)
      die "kb-board does not route registry command '$1'."
      ;;
    r|rule)
      die 'kb-board is for board-owned commands only; use kb directly for registry rules.'
      ;;
    init|schema|mcp|doctor|backup|restore|audit|dashboard|dash|w|ws|workspace|access|plugin|worker|link|scope|contrib)
      die "kb-board does not route registry-wide command '$1'."
      ;;
  esac
}

claim_identity_write() {
  case "$1" in
    claim)
      shift
      has_flag --candidates "$@" && return 1
      return 0 ;;
    heartbeat|hb) return 0 ;;
    handoff|h)
      case "${2-}" in accept|acc) return 0 ;; esac ;;
  esac
  return 1
}

# Only checkpoint and handoff create accept --repo/--branch/--head/--dirty.
# kanban captures them from its OWN cwd when they are omitted, and over ssh
# that cwd is the board host's, not the caller's checkout: measured
# 2026-09-05, 9 of 10 remote handoffs stored headSha null. So the wrapper
# captures the caller's checkout and passes the flags explicitly. A flag the
# caller gave still wins, and every other command travels exactly as given.
captures_git_provenance() {
  case "$1" in
    checkpoint|cp) return 0 ;;
    handoff|h|sitrep|sr)
      case "${2-}" in
        create|new|post) return 0 ;;
      esac
      ;;
  esac
  return 1
}

# The exact wording kanban's own capture writes to dirtySummary.
dirty_summary() {
  case "$1" in
    0) printf 'clean' ;;
    1) printf '1 file changed' ;;
    *) printf '%s files changed' "$1" ;;
  esac
}


board=${1-}
command=${2-}

if [[ -z "$board" || -z "$command" ]]; then
  die 'usage: kb-board BOARD COMMAND [ARGS...]'
fi

shift 2

reject_selector_args "$@"
reject_registry_commands "$command"

declare -a BOARD_IDS
declare -a BOARD_HOME_HOSTS
declare -a BOARD_SSH_TARGETS
declare -a BOARD_EXPECTED_REMOTE_HOSTS
declare -a BOARD_KB_EXECS

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
router_name=kb-board
source "$script_dir/kb-routing.sh"
table_file=${KB_HOSTS_TABLE:-"$script_dir/../hosts.tsv"}
ssh_bin=${KB_SSH_BIN:-ssh}

load_table "$table_file"

if ! lookup_board "$board"; then
  die "kb-board: unknown board: $board"
fi

kb_bin=$BOARD_KB_EXEC

case "$kb_bin" in
  /*) ;;
  *) die "kb-board: KB executable path must be absolute: $kb_bin" ;;
esac

if captures_git_provenance "$command" "${1-}" \
  && git_top=$(git rev-parse --show-toplevel 2>/dev/null) \
  && git_head=$(git -C "$git_top" rev-parse HEAD 2>/dev/null); then
  has_flag --repo "$@" || set -- "$@" --repo "$git_top"
  if ! has_flag --branch "$@"; then
    # symbolic-ref, not `branch --show-current`: a git too old for the latter
    # would print nothing and be recorded as detached, which is wrong
    # provenance rather than none. symbolic-ref fails only when HEAD is detached.
    git_branch=$(git -C "$git_top" symbolic-ref --short -q HEAD 2>/dev/null) || git_branch=DETACHED
    set -- "$@" --branch "$git_branch"
  fi
  has_flag --head "$@" || set -- "$@" --head "$git_head"
  if ! has_flag --dirty "$@"; then
    git_dirty=0
    while IFS= read -r line; do
      if [[ -n "${line//[[:space:]]/}" ]]; then
        git_dirty=$((git_dirty + 1))
      fi
    done < <(git -C "$git_top" status --porcelain 2>/dev/null)
    set -- "$@" --dirty "$(dirty_summary "$git_dirty")"
  fi
fi


# A routed lease write must identify the caller checkout, never the board host cwd.
if claim_identity_write "$command" "$@"; then
  capture_repo_identity "$command" "$@"
  set -- "${repo_identity_args[@]}"
fi

# `--body-file PATH` names a file on the CALLER, and the binary runs on the
# board host, so forwarding the flag literally made the remote read a path
# that does not exist there: `Error: read body from /tmp/x.md: No such file or
# directory`. Five commands take it (task add, task update, rule add, rule
# update, attention update) and it was unusable from any other machine.
#
# The body is transferred instead: base64 on the caller, decoded into a
# private temp file on the board host, and the flag rewritten to point at
# that. base64 because a body is prose that can contain any byte, newlines and
# quotes included, and it rides inside one already-quoted remote command
# rather than a second channel. The temp file is removed whatever the exit
# status, so a refusal leaves nothing behind.

# `--items-file PATH` is the same problem with a different answer. The path is
# the CALLER's while the binary runs on the board host, so forwarding it
# literally makes the remote read a path that is not there — but a `transact`'s
# items are one JSON document read exactly once, and `transact` reads nothing
# else from stdin. So the file is STREAMED as ssh's stdin and the remote flag
# is rewritten to `/dev/stdin`, which the binary reads like any other file.
# That is one ssh with no remote temp file, no base64 round trip and no ARG_MAX
# ceiling, and it makes a local path and the documented
# `--items-file /dev/stdin < items.json` form the same thing on the far side.
#
# /dev/stdin is staged only for identity-bearing batches; unchanged items
# retain their bytes even when the wrapper must replay the consumed stream.
body_file=""
items_file=""
args=()
items_json=""
items_arg_index=-1
while [[ $# -gt 0 ]]; do
  case "$1" in
    --body-file)
      [[ $# -ge 2 ]] || die 'kb-board: --body-file requires a path'
      [[ -z "$body_file" ]] || die 'kb-board: --body-file given twice'
      body_file=$2
      shift 2
      ;;
    --body-file=*)
      [[ -z "$body_file" ]] || die 'kb-board: --body-file given twice'
      body_file=${1#*=}
      shift
      ;;
    --items-file)
      [[ $# -ge 2 ]] || die 'kb-board: --items-file requires a path'
      [[ -z "$items_file" ]] || die 'kb-board: --items-file given twice'
      items_file=$2
      shift 2 ;;
    --items-file=*)
      [[ -z "$items_file" ]] || die 'kb-board: --items-file given twice'
      items_file=${1#*=}
      shift ;;
    --items)
      [[ $# -ge 2 ]] || die 'kb-board: --items requires JSON'
      items_json=$2
      items_arg_index=${#args[@]}
      args+=("$1" "$2")
      shift 2 ;;
    --items=*)
      items_json=${1#*=}
      items_arg_index=${#args[@]}
      args+=("$1")
      shift ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
if [[ -n "$body_file" ]]; then
  [[ -r "$body_file" ]] || die "kb-board: cannot read --body-file $body_file"
fi
if [[ -n "$items_file" ]]; then
  [[ -r "$items_file" ]] || die "kb-board: cannot read --items-file $items_file"
  # Both want ssh's stdin and no command takes both, so this is a refusal
  # rather than a precedence rule nothing could explain in a receipt.
  [[ -z "$body_file" ]] ||
    die 'kb-board: --body-file and --items-file both need the ssh channel; pass one'
fi
# Inline `--items` is the same batch by another spelling: a staged
# identity-bearing batch replays it on ssh's stdin and owns an EXIT trap that
# the body-file transfer would replace, leaking the staging directory. No
# command takes a body and items, so refuse before anything is staged or sent.
if [[ -n "$body_file" && "$items_arg_index" -ge 0 ]]; then
  die 'kb-board: --body-file and --items cannot be combined; no command takes both'
fi

staged=""
if [[ "$command" = transact && ( -n "$items_file" || "$items_arg_index" -ge 0 ) ]]; then
  staged=$(mktemp -d "${TMPDIR:-/tmp}/kb-items.XXXXXX") || die 'kb-board: cannot stage --items'
  trap 'rm -rf "$staged"' EXIT
  if [[ -n "$items_file" ]]; then
    cat -- "$items_file" >"$staged/input" || die 'kb-board: cannot read --items-file'
  else
    printf '%s' "$items_json" >"$staged/input"
  fi
  # The script already printed its own `kb-board:` reason; do not add a second.
  python3 "$script_dir/kb-repo-identity.py" items "$staged/input" "$staged/output" || exit 2
  if [[ -n "$items_file" ]]; then
    if ! cmp -s "$staged/input" "$staged/output"; then
      items_file="$staged/output"
    elif [[ "$items_file" = /dev/stdin ]]; then
      items_file="$staged/input"
    fi
  elif ! cmp -s "$staged/input" "$staged/output"; then
    if [[ "${args[$items_arg_index]}" = --items ]]; then
      args[$((items_arg_index + 1))]=$(cat "$staged/output")
    else
      args[$items_arg_index]="--items=$(cat "$staged/output")"
    fi
  fi
fi
set -- "${args[@]+${args[@]}}"

current_host=$(/bin/hostname)

if [[ "$current_host" = "$BOARD_HOME_HOST" ]]; then
  # Already at the boundary: the caller's path IS the board host's path.
  if [[ -n "$body_file" ]]; then
    exec "$kb_bin" --project "$board" "$command" "$@" --body-file "$body_file"
  fi
  if [[ -n "$items_file" ]]; then
    if [[ -n "$staged" ]]; then
      "$kb_bin" --project "$board" "$command" "$@" --items-file "$items_file"
      exit $?
    fi
    exec "$kb_bin" --project "$board" "$command" "$@" --items-file "$items_file"
  fi
  if [[ -n "$staged" ]]; then
    "$kb_bin" --project "$board" "$command" "$@"
    exit $?
  fi
  exec "$kb_bin" --project "$board" "$command" "$@"
fi

remote_cmd="if [ \"\$(/bin/hostname)\" = $(shell_quote "$BOARD_EXPECTED_REMOTE_HOST") ]; then"
if [[ -n "$body_file" ]]; then
  # The body rides ssh's STDIN, not the command string. Embedding it as an
  # argument capped the body at the board host's ARG_MAX: a 128KB plan died
  # with the shell's own `Argument list too long`, which is not a refusal this
  # wrapper could name. Streaming has no ceiling.
  remote_cmd+=" body=\$(mktemp \"\${TMPDIR:-/tmp}/kb-body.XXXXXX\") || exit 70;"
  remote_cmd+=" trap 'rm -f \"\$body\"' EXIT;"
  remote_cmd+=" base64 -d >\"\$body\" <&0 || exit 70;"
  remote_cmd+=" $(shell_quote "$kb_bin") --project $(shell_quote "$board") $(shell_quote "$command")"
else
  remote_cmd+=" exec $(shell_quote "$kb_bin") --project $(shell_quote "$board") $(shell_quote "$command")"
fi
for arg in "$@"; do
  remote_cmd+=" $(shell_quote "$arg")"
done
if [[ -n "$body_file" ]]; then
  # Not `exec`: the EXIT trap must still run to remove the decoded body.
  remote_cmd+=" --body-file \"\$body\""
fi
if [[ -n "$items_file" ]]; then
  # The items ride ssh's STDIN as themselves: `transact` reads its list once,
  # from a path, and `/dev/stdin` is that path on the board host.
  remote_cmd+=" --items-file $(shell_quote /dev/stdin)"
fi
remote_cmd+="; else printf '%s\n' 'kb-board: remote hostname mismatch' >&2; exit 69; fi"

if [[ -n "$body_file" ]]; then
  # Encode to a file rather than a pipe so the exit status is ssh's alone, and
  # do not `exec`, so the EXIT trap still removes the caller's copy.
  encoded=$(mktemp "${TMPDIR:-/tmp}/kb-body-enc.XXXXXX") || die 'kb-board: cannot stage --body-file'
  trap 'rm -f "$encoded"' EXIT
  base64 <"$body_file" >"$encoded" || die "kb-board: cannot encode --body-file $body_file"
  status=0
  "$ssh_bin" -- "$BOARD_SSH_TARGET" "$remote_cmd" <"$encoded" || status=$?
  exit "$status"
fi

if [[ -n "$items_file" ]]; then
  # Staged batches keep their EXIT trap until ssh finishes.
  if [[ -n "$staged" ]]; then
    "$ssh_bin" -- "$BOARD_SSH_TARGET" "$remote_cmd" <"$items_file"
    exit $?
  fi
  exec "$ssh_bin" -- "$BOARD_SSH_TARGET" "$remote_cmd" <"$items_file"
fi

if [[ -n "$staged" ]]; then
  "$ssh_bin" -- "$BOARD_SSH_TARGET" "$remote_cmd"
  exit $?
fi
exec "$ssh_bin" -- "$BOARD_SSH_TARGET" "$remote_cmd"
