#!/usr/bin/env bash
# kb-session-file — print the path of THIS session's heartbeat session file.
#
# The file holds two lines, task id then lease token, written by the claimant
# right after `kb claim` and read by a harness heartbeat hook. Concurrent
# sessions on one host must never share a file, or they overwrite each other's
# lease token.
#
# Namespace precedence:
#   1. A nonempty KB_SESSION_ID takes precedence and maps deterministically to
#      kb-session.d/session-<full sha256 hex of the id>. The hash keeps every
#      id a safe basename: traversal segments and sanitization lookalikes
#      (a/b vs a_b) hash to different names rather than sharing one (up to
#      the usual hash-collision odds). The same id reopens the same file;
#      different ids get different files.
#   2. Otherwise the path is keyed per terminal pane: the tmux socket path
#      (hashed, because two tmux servers both number their panes from %0) plus
#      $TMUX_PANE. The claimant's shell and the harness hook run in the same
#      pane, so both derive the same path without sharing anything else.
#   3. Outside tmux with no session id there is no stable per-session key both
#      sides can see, so the legacy single file is printed and the exit status
#      is 3: correct only when one session per host claims at a time.
#
# The session id is a filename namespace only: it confers no board, lane,
# role, or lease authority, and both sides must already agree on the id out
# of band (same shell environment). An explicitly empty, over-long (>256
# bytes), or control-character KB_SESSION_ID is refused with exit 65 and
# prints no path, so a caller capturing the path writes no token file.
#
#   kb-session-file            print the path; create its directory (0700)
#   kb-session-file --legacy   print the legacy single-file path only
#
# Environment: KB_SESSION_HOME (default $HOME/.claude) is where both live.
set -euo pipefail

base="${KB_SESSION_HOME:-$HOME/.claude}"
legacy="$base/kb-session"

if [ "${1:-}" = "--legacy" ]; then
  printf '%s\n' "$legacy"
  exit 0
fi
[ $# -eq 0 ] || { printf 'usage: kb-session-file [--legacy]\n' >&2; exit 64; }

if [ -n "${KB_SESSION_ID+set}" ]; then
  sid="$KB_SESSION_ID"
  if [ -z "$sid" ]; then
    printf 'kb-session-file: empty KB_SESSION_ID refused; unset it for tmux/legacy or export a nonempty session identity\n' >&2
    exit 65
  fi
  # Byte count, not character count: ${#sid} counts characters under UTF-8.
  sid_len=$(printf '%s' "$sid" | wc -c | tr -d ' ')
  if [ "$sid_len" -gt 256 ]; then
    printf 'kb-session-file: KB_SESSION_ID longer than 256 bytes refused\n' >&2
    exit 65
  fi
  # grep is line-oriented and never matches an embedded newline, so refuse
  # newlines explicitly before the control-character scan below.
  case "$sid" in
    *$'\n'*) printf 'kb-session-file: KB_SESSION_ID with control characters refused\n' >&2; exit 65;;
  esac
  if printf '%s' "$sid" | LC_ALL=C grep -q '[[:cntrl:]]' 2>/dev/null; then
    printf 'kb-session-file: KB_SESSION_ID with control characters refused\n' >&2
    exit 65
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    shash=$(printf '%s' "$sid" | sha256sum)
  else
    shash=$(printf '%s' "$sid" | shasum -a 256)
  fi
  shash=${shash%% *}
  dir="$base/kb-session.d"
  mkdir -p "$dir"
  chmod 700 "$dir"
  printf '%s/session-%s\n' "$dir" "$shash"
  exit 0
fi

if [ -z "${TMUX:-}" ] || [ -z "${TMUX_PANE:-}" ]; then
  printf '%s\n' "$legacy"
  exit 3
fi

socket=${TMUX%%,*}
if command -v sha256sum >/dev/null 2>&1; then
  hash=$(printf '%s' "$socket" | sha256sum)
else
  hash=$(printf '%s' "$socket" | shasum -a 256)
fi
pane=${TMUX_PANE#%}
case "$pane" in ''|*[!0-9]*) printf 'kb-session-file: unexpected TMUX_PANE %s\n' "$TMUX_PANE" >&2; exit 65;; esac

dir="$base/kb-session.d"
mkdir -p "$dir"
chmod 700 "$dir"
printf '%s/tmux-%s-%s\n' "$dir" "${hash:0:12}" "$pane"
